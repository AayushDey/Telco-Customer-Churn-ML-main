# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── OS cruft ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── ML artifacts (generated by training pipeline) ─────────────────────────────
mlruns/
artifacts/
mlflow.db
*.db
*.sqlite*

# ── Data (raw & processed) ────────────────────────────────────────────────────
# Keep .gitkeep placeholder files so empty dirs are tracked
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/

# ── Gradio ────────────────────────────────────────────────────────────────────
.gradio/

# ── Keep bundled serving model ────────────────────────────────────────────────
!src/serving/model/
!src/serving/model/**
